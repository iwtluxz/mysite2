PORT=3000
ALLOWED_ORIGINS=https://iwtluxz.github.io
USER_SESSION_TTL_DAYS=30
TELEGRAM_BOT_TOKEN=replace_with_new_token_from_botfather
TELEGRAM_ADMIN_CHAT_IDS=123456789
PUBLIC_BASE_URL=https://your-backend.onrender.com
# Optional custom RPC endpoints for balance lookup (comma-separated fallbacks are supported):
# ETHEREUM_RPC_URL=
# BSC_RPC_URL=
# POLYGON_RPC_URL=
# BASE_RPC_URL=
# ARBITRUM_RPC_URL=
# OPTIMISM_RPC_URL=
# Optional TRON settings for USDT TRC20 balance lookup:
# TRON_FULL_HOST=https://api.trongrid.io
# TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
# Optional TronGrid API key if public requests are rate-limited:
# TRON_PRO_API_KEY=
# Treasury wallets for admin /withdraw (service-owned keys only, never user wallets):
# TRON_TREASURY_PRIVATE_KEY=
# EVM_TREASURY_PRIVATE_KEY=
# Optional default recipients for admin /payment requests. Users still confirm every transfer in their wallet:
# PAYMENT_EVM_RECIPIENT=
# PAYMENT_TRON_RECIPIENT=
